# syntax=docker/dockerfile:1

# --- Stage 1: Build Web & App ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.18.0 --activate

WORKDIR /app

# Copy root config files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/core/package.json ./packages/core/
COPY apps/web/package.json ./apps/web/
COPY apps/app/package.json ./apps/app/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/
COPY apps/app/ ./apps/app/

# Build core packages, web and app
RUN pnpm build

# Move built React PWA into Astro static dist/app/ so Caddy can serve both seamlessly
RUN mkdir -p /app/apps/web/dist/app && cp -r /app/apps/app/dist/* /app/apps/web/dist/app/

# --- Stage 2: Serve with Caddy ---
FROM caddy:2-alpine

COPY --from=builder /app/apps/web/dist /srv

# Default Caddyfile for static serving with proper security headers
RUN printf ':8080 {\n\
    root * /srv\n\
    file_server\n\
    encode zstd gzip\n\
\n\
    header {\n\
        X-Content-Type-Options nosniff\n\
        X-Frame-Options DENY\n\
        Referrer-Policy strict-origin-when-cross-origin\n\
        Strict-Transport-Security "max-age=31536000; includeSubDomains"\n\
        -Server\n\
    }\n\
\n\
    @pwa path /app/*\n\
    handle @pwa {\n\
        try_files {path} /app/index.html\n\
    }\n\
}\n' > /etc/caddy/Caddyfile

EXPOSE 8080

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
