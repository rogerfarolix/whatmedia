# Copier en .env sur le serveur. Ne jamais committer .env.

GH_OWNER=<owner-github-en-minuscules>
IMAGE_TAG=latest
ACME_EMAIL=<email-pour-lets-encrypt>

# --- API de secours ---
WHATMEDIA_API_ENABLED=true
PUBLIC_ORIGIN=https://whatmedia.nealix.org
MAX_UPLOAD_BYTES=1073741824
MAX_DURATION_SEC=600
CONCURRENCY=2
QUEUE_MAX=20
RATE_LIMIT_PER_HOUR=10
RETENTION_MINUTES=15
FFMPEG_TIMEOUT_SEC=900
API_CPUS=2
API_MEMORY=2g
LOG_LEVEL=info

# --- Statistiques (none | umami | plausible) ---
ANALYTICS=none
ANALYTICS_URL=

# Profils Compose actifs (edge = Caddy intégré, api = serveur de secours)
COMPOSE_PROFILES=edge,api
