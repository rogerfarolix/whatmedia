# Caddy inside the `web` container: serves the landing (/) and the PWA (/app), and forwards
# /api/v1/* to the fallback API container. The host's nginx only needs to proxy everything
# to this container (see deploy/whatmedia.nealix.org.conf), so the API works without touching nginx.
{
	admin off
	servers {
		# nginx (host) → docker-proxy → this Caddy: keep the client IP in X-Forwarded-For.
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	# X-Frame-Options is NOT set here: the host nginx already adds one, and two conflicting values
	# make browsers ignore it. CSP frame-ancestors 'none' below is the modern equivalent.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	# PWA: strict, no inline script, no third party (ADR 0003).
	@app path /app /app/*
	header @app Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

	# Landing: no inline script (JSON-LD blocks are data, not executed).
	@site not path /app /app/* /api/*
	header @site Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"

	# The service worker and app shell must always be revalidated, or updates never reach users.
	@nocache path /app/ /app/index.html /app/sw.js /app/registerSW.js /app/manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	@immutable path /app/assets/* /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@fonts path /fonts/* /og-image.png /apple-touch-icon.png /favicon.svg
	header @fonts Cache-Control "public, max-age=2592000"

	handle /api/v1/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			# Long polling / big uploads: no buffering, generous timeouts.
			flush_interval -1
			transport http {
				read_timeout 15m
				write_timeout 15m
			}
		}
	}

	handle /app/* {
		# Real files (with an extension) must 404 when missing instead of returning the app shell.
		@asset path_regexp \.[A-Za-z0-9]+$
		handle @asset {
			file_server
		}
		handle {
			try_files {path} /app/index.html
			file_server
		}
	}

	handle {
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
