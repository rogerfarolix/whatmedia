# syntax=docker/dockerfile:1

# --- Stage 1: Build API ---
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@12.18.0 --activate

WORKDIR /app

# Copy root configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/core/package.json ./packages/core/
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy sources
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Build core and API using turbo to ensure all dependencies build their dist
RUN pnpm --filter @whatmedia/config build && \
    pnpm --filter @whatmedia/core build && \
    pnpm --filter @whatmedia/api build

# --- Stage 2: Hardened Runtime with ffmpeg ---
FROM node:22-alpine

# Install ffmpeg with libx264
RUN apk add --no-cache ffmpeg

WORKDIR /app

# Non-root user (node:node is UID 1000)
RUN mkdir -p /data/jobs /data/stats && chown -R node:node /data/jobs /data/stats

COPY --from=builder /app /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0
ENV DATA_DIR=/data/jobs
ENV TRUST_PROXY_HOPS=0

USER node

EXPOSE 3000

CMD ["node", "apps/api/dist/server.js"]
