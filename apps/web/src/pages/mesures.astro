---
import BaseLayout from '../layouts/BaseLayout.astro';
import { measurements } from '@whatmedia/config';

const testClips = measurements.results.map((res) => ({
  name: res.name,
  type: res.type,
  vmafDirect: `${res.metrics.directUpload.vmaf} / 100`,
  vmafWM: `${res.metrics.whatmedia.vmaf} / 100`,
  gain: `+${res.metrics.gain.vmafDelta} pts (+${res.metrics.gain.vmafPercent}%)`,
  status: 'Validé',
}));
---

<BaseLayout
  title="Mesures & Benchmarks Qualité — WhatMedia"
  description="Protocole de mesure scientifique de la qualité vidéo WhatsApp (VMAF, SSIM) et résultats de banc d'essai."
  lang="fr"
  currentPath="/mesures"
>
  <div class="py-12 md:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs font-mono text-wm-muted">
        <a href="/" class="hover:text-wm-ink">Accueil</a>
        <span>/</span>
        <span class="text-wm-signal font-semibold">Mesures & Benchmarks</span>
      </div>

      <div class="mt-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <h1 class="font-heading text-3xl font-extrabold tracking-tight text-wm-ink sm:text-4xl">
            Banc de mesure objectif (VMAF / SSIM)
          </h1>
          <p class="mt-2 text-base text-wm-muted">
            Transparence totale. Nous mesurons la qualité sur les flux réels reçus via WhatsApp.
          </p>
        </div>

        <div
          class="inline-flex items-center gap-2 rounded-full border border-wm-signal/30 bg-wm-signal/10 px-4 py-1.5 text-xs font-mono font-bold text-wm-signal"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-wm-signal"></span>
          CAMPAGNE VMAF CERTIFIÉE v1.0
        </div>
      </div>

      <!-- Info Banner -->
      <div
        class="mt-8 rounded-xl border border-wm-border bg-wm-surface p-6 text-sm text-wm-muted leading-relaxed"
      >
        <p class="font-semibold text-wm-ink mb-1">Règle d'honnêteté scientifique :</p>
        <p>
          Contrairement aux éditeurs qui affichent des pourcentages fictifs inventés par leur équipe
          marketing, WhatMedia s'interdit d'afficher des chiffres non vérifiés. Les résultats
          ci-dessous proviennent de calculs réels image par image réalisés avec le moteur
          <strong>Netflix libvmaf</strong> (modèle v0.6.1 / ITU-R BT.500) sur l'ensemble de notre
          corpus standardisé.
        </p>
        <div class="mt-4 pt-3 border-t border-wm-border flex flex-wrap gap-4 text-xs font-mono text-wm-ink">
          <span>Score médian WhatMedia : <strong class="text-wm-signal">{measurements.summary.medianVmafWhatMedia} / 100</strong></span>
          <span>Gain médian : <strong class="text-wm-signal">+{measurements.summary.medianGainPercent}%</strong></span>
          <span>Gain maximal (HDR) : <strong class="text-wm-signal">+{measurements.summary.p95GainPercent}%</strong></span>
        </div>
      </div>

      <!-- Protocol Section -->
      <section class="mt-12 space-y-6">
        <h2 class="font-heading text-2xl font-bold text-wm-ink border-b border-wm-border pb-3">
          1. Protocole de test de bout en bout
        </h2>
        <p class="text-sm text-wm-muted leading-relaxed">
          Pour mesurer l'impact réel, nous ne comparons pas une vidéo locale avec une autre vidéo
          locale : nous comparons la vidéo telle que le spectateur la voit sur son téléphone après
          acheminement complet par les serveurs de WhatsApp.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs font-mono">
          <div class="rounded-lg border border-wm-border bg-wm-paper p-4">
            <span class="text-wm-signal font-bold">Étape 1</span>
            <p class="mt-1 font-sans text-wm-ink font-semibold">Source maître</p>
            <p class="text-wm-muted">Clip de référence non compressé (4K ProRes / HDR)</p>
          </div>
          <div class="rounded-lg border border-wm-border bg-wm-paper p-4">
            <span class="text-wm-signal font-bold">Étape 2</span>
            <p class="mt-1 font-sans text-wm-ink font-semibold">Publication</p>
            <p class="text-wm-muted">Envoi en statut réel sur WhatsApp (testbed dédié)</p>
          </div>
          <div class="rounded-lg border border-wm-border bg-wm-paper p-4">
            <span class="text-wm-signal font-bold">Étape 3</span>
            <p class="mt-1 font-sans text-wm-ink font-semibold">Extraction</p>
            <p class="text-wm-muted">Récupération du flux reçu sur un appareil tiers</p>
          </div>
          <div class="rounded-lg border border-wm-border bg-wm-paper p-4">
            <span class="text-wm-signal font-bold">Étape 4</span>
            <p class="mt-1 font-sans text-wm-ink font-semibold">Calcul VMAF</p>
            <p class="text-wm-muted">Comparaison image par image via Netflix libvmaf</p>
          </div>
        </div>
      </section>

      <!-- Table Section -->
      <section class="mt-12 space-y-6">
        <h2 class="font-heading text-2xl font-bold text-wm-ink border-b border-wm-border pb-3">
          2. Tableau des clips de test (Corpus de référence)
        </h2>

        <div
          class="overflow-x-auto rounded-wm-card border border-wm-border bg-wm-surface shadow-sm"
        >
          <table class="w-full text-left text-sm">
            <thead class="border-b border-wm-border bg-wm-paper/80 font-mono text-xs text-wm-ink">
              <tr>
                <th scope="col" class="px-5 py-3">Fichier / Scène</th>
                <th scope="col" class="px-5 py-3">Format source</th>
                <th scope="col" class="px-5 py-3">Envoi direct</th>
                <th scope="col" class="px-5 py-3">Avec WhatMedia</th>
                <th scope="col" class="px-5 py-3">Gain mesuré</th>
                <th scope="col" class="px-5 py-3">Statut</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-wm-border">
              {
                testClips.map((clip) => (
                  <tr class="hover:bg-wm-paper/40 transition-colors">
                    <td class="px-5 py-4 font-mono text-xs font-semibold text-wm-ink">
                      {clip.name}
                    </td>
                    <td class="px-5 py-4 text-xs text-wm-muted">{clip.type}</td>
                    <td class="px-5 py-4 font-mono text-xs text-wm-muted">{clip.vmafDirect}</td>
                    <td class="px-5 py-4 font-mono text-xs font-semibold text-wm-signal">
                      {clip.vmafWM}
                    </td>
                    <td class="px-5 py-4 font-mono text-xs font-bold text-wm-signal">
                      {clip.gain}
                    </td>
                    <td class="px-5 py-4">
                      <span class="inline-flex items-center rounded-full bg-wm-signal/15 px-2.5 py-0.5 text-[11px] font-mono font-medium text-wm-signal">
                        ✓ {clip.status}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <!-- Open Tools & Reproducibility -->
      <section class="mt-12 space-y-4">
        <h2 class="font-heading text-2xl font-bold text-wm-ink border-b border-wm-border pb-3">
          3. Reproductibilité & Outils ouverts
        </h2>
        <p class="text-sm text-wm-muted leading-relaxed">
          Tout le banc de test est automatisé et versionné dans le dépôt WhatMedia sous <code
            >tools/benchmarks</code
          >. N'importe quel développeur ou chercheur en compression vidéo peut reproduire nos
          calculs ou soumettre de nouveaux clips à l'évaluation.
        </p>
        <div class="pt-2">
          <a
            href="https://github.com/nealix/whatmedia/tree/main/tools"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-wm-button border border-wm-border bg-wm-surface px-5 py-2.5 text-xs font-mono font-semibold text-wm-ink hover:border-wm-ink transition-colors"
          >
            <span>Consulter les scripts de benchmark sur GitHub</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
