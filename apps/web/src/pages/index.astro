---
import BaseLayout from '../layouts/BaseLayout.astro';
import BeforeAfterComparator from '../components/BeforeAfterComparator.astro';

const faqs = [
  {
    q: 'WhatMedia supprime-t-il la compression de WhatsApp ?',
    a: "Non, personne ne le peut. WhatsApp réencode systématiquement toutes les vidéos envoyées en statut. WhatMedia prépare le fichier en amont (résolution idéale, débit maîtrisé, profil H.264 compatible, conversion SDR BT.709 propre) pour que l'algorithme de WhatsApp n'ait presque rien à dégrader.",
  },
  {
    q: "C'est vraiment gratuit et sans publicité ?",
    a: "Oui, 100 % gratuit et open source sous licence MIT. Il n'y a aucun compte requis, aucun abonnement payant, aucun filigrane ajouté sur vos créations et aucun traceur publicitaire.",
  },
  {
    q: 'Mes vidéos sont-elles envoyées sur un serveur distant ?',
    a: "Non par défaut. Le traitement est effectué directement dans votre navigateur web grâce aux technologies WebAssembly et WebCodecs. Vos vidéos ne quittent jamais votre smartphone. Le serveur de secours n'est proposé que si votre appareil ne supporte pas l'encodage local, et uniquement avec votre accord explicite.",
  },
  {
    q: 'Faut-il créer un compte ou installer une application lourde ?',
    a: "Non, aucun compte n'est nécessaire. WhatMedia fonctionne instantanément depuis Safari, Chrome ou Firefox. Vous pouvez l'ajouter en un clic sur votre écran d'accueil comme une application native (PWA) qui fonctionne même hors-ligne.",
  },
  {
    q: 'Pourquoi découper ma vidéo en plusieurs segments ?',
    a: 'WhatsApp bride strictement la durée de chaque statut (30 à 60 secondes selon les versions) et alloue un plafond de données par segment. Découper votre vidéo longue en segments calibrés préserve une netteté maximale sans coupure brutale.',
  },
  {
    q: 'WhatMedia est-il lié à WhatsApp ou Meta ?',
    a: "Non. WhatMedia est un projet open source totalement indépendant développé par Nealix. Il n'est ni affilié, ni sponsorisé, ni validé par WhatsApp LLC ou Meta Platforms, Inc.",
  },
];
---

<BaseLayout
  title="WhatMedia — Tes statuts WhatsApp, enfin nets."
  description="WhatMedia prépare tes vidéos et photos pour qu'elles survivent à la compression de WhatsApp. Directement sur ton téléphone. Rien n'est envoyé."
  lang="fr"
  currentPath="/"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Pill Surtitre -->
        <div
          class="inline-flex items-center gap-2 rounded-full border border-wm-signal/20 bg-wm-signal-light px-3.5 py-1 text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-wm-signal animate-pulse"></span>
          OPEN SOURCE · GRATUIT · SANS COMPTE
        </div>

        <!-- H1 Headline -->
        <h1
          class="mt-6 font-heading text-4xl font-extrabold tracking-tight text-wm-ink sm:text-5xl md:text-6xl"
        >
          Tes statuts WhatsApp, <br class="hidden sm:inline" />
          <span class="text-wm-signal">enfin nets.</span>
        </h1>

        <!-- Subheadline -->
        <p class="mt-6 text-lg sm:text-xl text-wm-muted leading-relaxed">
          WhatMedia prépare tes vidéos et tes photos pour qu'elles survivent à la compression de
          WhatsApp. Directement sur ton téléphone. Rien n'est envoyé.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/app/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-wm-button bg-wm-signal px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-wm-signal/25 hover:bg-wm-signal-hover hover:shadow-wm-signal/35 transition-all transform active:scale-98"
          >
            <span>Ouvrir WhatMedia</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="https://github.com/nealix/whatmedia"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-wm-button border border-wm-border bg-wm-surface px-6 py-3.5 text-base font-semibold text-wm-ink hover:border-wm-ink hover:bg-wm-surface-elevated transition-all"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Voir sur GitHub</span>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-6 text-xs text-wm-muted">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-wm-ok" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            100% sur ton téléphone
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-wm-ok" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            Sans inscription
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-wm-ok" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            Licence MIT
          </span>
        </div>
      </div>

      <!-- Interactive Comparator Component -->
      <div class="mt-14">
        <BeforeAfterComparator lang="fr" />
      </div>
    </div>
  </section>

  <!-- The Problem Section (3 Cards) -->
  <section class="border-t border-wm-border bg-wm-surface py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          Le Problème
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Pourquoi tes statuts sont massacrés
        </p>
        <p class="mt-3 text-base text-wm-muted">
          Quand tu publies une belle vidéo sur WhatsApp, l'application applique un algorithme de
          recompression brutal qui ruine le résultat.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Card 1: Floue -->
        <div
          class="rounded-wm-card border border-wm-border bg-wm-paper p-7 shadow-sm transition-all hover:border-wm-signal/40 hover:shadow-md"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-wm-warn-light text-wm-warn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <h3 class="mt-5 font-heading text-xl font-bold text-wm-ink">Floue</h3>
          <p class="mt-2 text-sm leading-relaxed text-wm-muted">
            WhatsApp réduit drastiquement le débit binaire des fichiers volumineux. Les visages
            deviennent boueux et les détails fins disparaissent sous d'épais macroblocs de
            compression.
          </p>
        </div>

        <!-- Card 2: Délavée -->
        <div
          class="rounded-wm-card border border-wm-border bg-wm-paper p-7 shadow-sm transition-all hover:border-wm-signal/40 hover:shadow-md"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-wm-warn-light text-wm-warn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
              ></path>
            </svg>
          </div>
          <h3 class="mt-5 font-heading text-xl font-bold text-wm-ink">Délavée</h3>
          <p class="mt-2 text-sm leading-relaxed text-wm-muted">
            Les vidéos filmées en HDR (sur iPhone ou Android récent) voient leurs espaces
            colorimétriques tronqués sans conversion appropriée. L'image devient terne, grise et
            délavée.
          </p>
        </div>

        <!-- Card 3: Coupée -->
        <div
          class="rounded-wm-card border border-wm-border bg-wm-paper p-7 shadow-sm transition-all hover:border-wm-signal/40 hover:shadow-md"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-wm-warn-light text-wm-warn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"
              ></path>
            </svg>
          </div>
          <h3 class="mt-5 font-heading text-xl font-bold text-wm-ink">Coupée</h3>
          <p class="mt-2 text-sm leading-relaxed text-wm-muted">
            Les vidéos longues sont tronquées net au bout de 30 secondes. Sans découpage propre à
            l'avance, vos phrases sont interrompues en plein milieu et vos séquences gâchées.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section (3 Steps) -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          La Solution
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Comment ça marche
        </p>
        <p class="mt-3 text-base text-wm-muted">
          Trois étapes simples pour devancer les contraintes de WhatsApp et obtenir un résultat
          impeccable.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
        <!-- Step 1 -->
        <div
          class="relative flex flex-col items-center text-center p-6 rounded-wm-card bg-wm-surface border border-wm-border"
        >
          <div
            class="flex h-14 w-14 items-center justify-center rounded-full bg-wm-signal text-white font-heading text-xl font-bold shadow-md"
          >
            1
          </div>
          <h3 class="mt-6 font-heading text-lg font-bold text-wm-ink">Choisis ta vidéo</h3>
          <p class="mt-2 text-sm text-wm-muted">
            Sélectionne n'importe quelle vidéo ou photo depuis ta galerie. WhatMedia analyse
            instantanément sa résolution, son débit et sa colorimétrie.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="relative flex flex-col items-center text-center p-6 rounded-wm-card bg-wm-surface border border-wm-border"
        >
          <div
            class="flex h-14 w-14 items-center justify-center rounded-full bg-wm-signal text-white font-heading text-xl font-bold shadow-md"
          >
            2
          </div>
          <h3 class="mt-6 font-heading text-lg font-bold text-wm-ink">WhatMedia l'optimise</h3>
          <p class="mt-2 text-sm text-wm-muted">
            Ton téléphone la convertit au format exact que WhatsApp attend (H.264 calibré, BT.709
            propre, 30 i/s) et la découpe en segments harmonieux.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="relative flex flex-col items-center text-center p-6 rounded-wm-card bg-wm-surface border border-wm-border"
        >
          <div
            class="flex h-14 w-14 items-center justify-center rounded-full bg-wm-signal text-white font-heading text-xl font-bold shadow-md"
          >
            3
          </div>
          <h3 class="mt-6 font-heading text-lg font-bold text-wm-ink">Partage dans ton statut</h3>
          <p class="mt-2 text-sm text-wm-muted">
            Envoie directement tes segments prêts vers WhatsApp via le bouton de partage. WhatsApp
            ne dégrade plus ton contenu !
          </p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/comment-ca-marche"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-wm-signal hover:text-wm-signal-hover hover:underline underline-offset-4"
        >
          <span>Lire l'explication technique détaillée (débit, HDR, codecs)</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- The Numbers / Benchmarks Section -->
  <!-- Strict rule: NEVER invent quality numbers. Show "Mesures en cours" -->
  <section class="border-y border-wm-border bg-wm-surface py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          Mesures & Données
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Des résultats objectifs, validés en labo
        </p>
        <p class="mt-3 text-base text-wm-muted">
          Pas de promesses magiques. Nous publions les mesures VMAF et SSIM objectives sur les flux
          réellement servis par WhatsApp.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
        <!-- Metric 1: Gain VMAF -->
        <div
          class="flex flex-col items-center justify-center rounded-wm-card border border-wm-border bg-wm-paper p-8 text-center"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-wm-muted"
            >Gain VMAF moyen</span
          >
          <span class="mt-3 font-mono text-2xl md:text-3xl font-bold text-wm-warn">
            Mesures en cours
          </span>
          <span class="mt-2 text-xs text-wm-muted">Protocole de banc d'essai ouvert</span>
        </div>

        <!-- Metric 2: Clips testés -->
        <div
          class="flex flex-col items-center justify-center rounded-wm-card border border-wm-border bg-wm-paper p-8 text-center"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-wm-muted"
            >Clips de référence testés</span
          >
          <span class="mt-3 font-mono text-2xl md:text-3xl font-bold text-wm-warn">
            Mesures en cours
          </span>
          <span class="mt-2 text-xs text-wm-muted"
            >Corpus varié (HDR, 60fps, paysages, visages)</span
          >
        </div>

        <!-- Metric 3: Date des mesures -->
        <div
          class="flex flex-col items-center justify-center rounded-wm-card border border-wm-border bg-wm-paper p-8 text-center"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-wm-muted"
            >Dernière mise à jour</span
          >
          <span class="mt-3 font-mono text-2xl md:text-3xl font-bold text-wm-warn">
            Mesures en cours
          </span>
          <span class="mt-2 text-xs text-wm-muted">Consolidation continue des données</span>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a
          href="/mesures"
          class="inline-flex items-center gap-2 rounded-wm-button border border-wm-border bg-wm-paper px-5 py-2.5 text-sm font-semibold text-wm-ink hover:border-wm-ink transition-colors"
        >
          <span>Consulter le protocole et les graphiques de test</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Privacy Section -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-wm-ok/30 bg-wm-ok-light/40 p-8 md:p-12">
        <div class="max-w-3xl">
          <div
            class="inline-flex items-center gap-2 rounded-full bg-wm-ok/10 px-3 py-1 text-xs font-bold text-wm-ok"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            PRIVACY BY DESIGN
          </div>
          <h2 class="mt-4 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
            Tes vidéos ne quittent jamais ton téléphone.
          </h2>
          <p class="mt-4 text-base sm:text-lg text-wm-muted leading-relaxed">
            Contrairement aux compresseurs en ligne classiques qui envoient tes fichiers personnels
            sur des serveurs distants inconnus, WhatMedia exécute tout le transcodage en local dans
            la mémoire de ton appareil. Aucun octet de vidéo n'est envoyé nulle part.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              href="/confidentialite"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-wm-ink underline decoration-wm-ink/30 underline-offset-4 hover:decoration-wm-ink"
            >
              <span>Lire la politique de confidentialité</span>
            </a>
            <span class="text-wm-muted">·</span>
            <a
              href="https://github.com/nealix/whatmedia"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-wm-ink underline decoration-wm-ink/30 underline-offset-4 hover:decoration-wm-ink"
            >
              <span>Vérifier le code source sur GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Install Guide Section (PWA iOS Safari & Android Chrome) -->
  <section class="border-t border-wm-border bg-wm-surface py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          Installation Instantanée
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Installe WhatMedia sur ton écran d'accueil
        </p>
        <p class="mt-3 text-base text-wm-muted">
