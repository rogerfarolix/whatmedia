---
import FeaturePage from '../../views/FeaturePage.astro';
import { features, type Feature } from '../../content/features';

export function getStaticPaths() {
  return features.map((feature) => ({ params: { slug: feature.fr.slug }, props: { feature } }));
}

const { feature } = Astro.props as { feature: Feature };
---

<FeaturePage lang="fr" feature={feature} />
