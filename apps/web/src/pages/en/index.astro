---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeforeAfterComparator from '../../components/BeforeAfterComparator.astro';

const faqs = [
  {
    q: 'Does WhatMedia remove WhatsApp compression?',
    a: "No, nobody can. WhatsApp systematically re-encodes all status videos on upload. WhatMedia prepares the file beforehand (ideal resolution, controlled bitrate, compatible H.264 profile, clean SDR BT.709 color conversion) so WhatsApp's algorithm finds almost nothing left to degrade.",
  },
  {
    q: 'Is it really free and without ads?',
    a: 'Yes, 100% free and open-source under the MIT license. There is no account required, no paid subscription, no watermark added to your media, and zero ad trackers.',
  },
  {
    q: 'Are my videos uploaded to a remote server?',
    a: 'No by default. Transcoding runs directly inside your web browser using WebAssembly and WebCodecs technologies. Your personal videos never leave your smartphone. A fallback server is only offered if your phone cannot handle local encoding, and strictly with your explicit consent.',
  },
  {
    q: 'Do I need to create an account or install a heavy native app?',
    a: 'No account is required. WhatMedia runs instantly in Safari, Chrome, or Firefox. You can install it on your home screen with one tap as a Progressive Web App (PWA) that also works offline.',
  },
  {
    q: 'Why split long videos into segments?',
    a: 'WhatsApp strictly limits status duration (30 to 60 seconds depending on version) and caps total data per clip. Splitting long videos into calibrated segments keeps maximum sharpness without awkward mid-sentence cut-offs.',
  },
  {
    q: 'Is WhatMedia affiliated with WhatsApp or Meta?',
    a: 'No. WhatMedia is an independent, community-driven open source project created by Nealix. It is not affiliated, sponsored, or endorsed by WhatsApp LLC or Meta Platforms, Inc.',
  },
];
---

<BaseLayout
  title="WhatMedia — Crisp WhatsApp Statuses, Free & Open Source"
  description="WhatMedia prepares your videos and photos to survive WhatsApp compression. Directly on your device. Nothing is uploaded."
  lang="en"
  currentPath="/en/"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <!-- Pill Surtitre -->
        <div
          class="inline-flex items-center gap-2 rounded-full border border-wm-signal/20 bg-wm-signal-light px-3.5 py-1 text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-wm-signal animate-pulse"></span>
          OPEN SOURCE · FREE · NO ACCOUNT
        </div>

        <!-- H1 Headline -->
        <h1
          class="mt-6 font-heading text-4xl font-extrabold tracking-tight text-wm-ink sm:text-5xl md:text-6xl"
        >
          Your WhatsApp statuses, <br class="hidden sm:inline" />
          <span class="text-wm-signal">finally crisp.</span>
        </h1>

        <!-- Subheadline -->
        <p class="mt-6 text-lg sm:text-xl text-wm-muted leading-relaxed">
          WhatMedia optimizes your videos and photos so they survive WhatsApp's compression.
          Directly on your phone. Nothing is uploaded.
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/app/"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-wm-button bg-wm-signal px-7 py-3.5 text-base font-semibold text-white shadow-lg shadow-wm-signal/25 hover:bg-wm-signal-hover hover:shadow-wm-signal/35 transition-all transform active:scale-98"
          >
            <span>Open WhatMedia</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="https://github.com/nealix/whatmedia"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 rounded-wm-button border border-wm-border bg-wm-surface px-6 py-3.5 text-base font-semibold text-wm-ink hover:border-wm-ink hover:bg-wm-surface-elevated transition-all"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
            <span>View on GitHub</span>
          </a>
        </div>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-6 text-xs text-wm-muted">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-wm-ok" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            100% on your phone
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-wm-ok" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            No registration needed
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-wm-ok" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            MIT License
          </span>
        </div>
      </div>

      <!-- Interactive Comparator Component -->
      <div class="mt-14">
        <BeforeAfterComparator lang="en" />
      </div>
    </div>
  </section>

  <!-- The Problem Section (3 Cards) -->
  <section class="border-t border-wm-border bg-wm-surface py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          The Problem
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Why WhatsApp ruins your statuses
        </p>
        <p class="mt-3 text-base text-wm-muted">
          Whenever you post a high-quality video, WhatsApp triggers an aggressive re-encoding pass
          that wrecks fine visual details.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Card 1: Blurry -->
        <div
          class="rounded-wm-card border border-wm-border bg-wm-paper p-7 shadow-sm transition-all hover:border-wm-signal/40 hover:shadow-md"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-wm-warn-light text-wm-warn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <h3 class="mt-5 font-heading text-xl font-bold text-wm-ink">Blurry</h3>
          <p class="mt-2 text-sm leading-relaxed text-wm-muted">
            WhatsApp drastically lowers the bitrate of high-resolution files. Faces get smudged and
            texture details dissolve behind visible compression artifacts.
          </p>
        </div>

        <!-- Card 2: Washed Out -->
        <div
          class="rounded-wm-card border border-wm-border bg-wm-paper p-7 shadow-sm transition-all hover:border-wm-signal/40 hover:shadow-md"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-wm-warn-light text-wm-warn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
              ></path>
            </svg>
          </div>
          <h3 class="mt-5 font-heading text-xl font-bold text-wm-ink">Washed Out</h3>
          <p class="mt-2 text-sm leading-relaxed text-wm-muted">
            HDR clips recorded on recent iPhones or Android flagships get clipped without proper
            tone mapping. The picture becomes dull, gray, and lifeless.
          </p>
        </div>

        <!-- Card 3: Cut Off -->
        <div
          class="rounded-wm-card border border-wm-border bg-wm-paper p-7 shadow-sm transition-all hover:border-wm-signal/40 hover:shadow-md"
        >
          <div
            class="flex h-12 w-12 items-center justify-center rounded-xl bg-wm-warn-light text-wm-warn"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"
              ></path>
            </svg>
          </div>
          <h3 class="mt-5 font-heading text-xl font-bold text-wm-ink">Cut Off</h3>
          <p class="mt-2 text-sm leading-relaxed text-wm-muted">
            Longer videos get ruthlessly truncated at 30 seconds. Without clean pre-segmentation,
            sentences get cut in half and story flow is broken.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Section (3 Steps) -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          The Solution
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          How it works
        </p>
        <p class="mt-3 text-base text-wm-muted">
          Three simple steps to beat WhatsApp constraints and get flawless results.
        </p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-3">
        <!-- Step 1 -->
        <div
          class="relative flex flex-col items-center text-center p-6 rounded-wm-card bg-wm-surface border border-wm-border"
        >
          <div
            class="flex h-14 w-14 items-center justify-center rounded-full bg-wm-signal text-white font-heading text-xl font-bold shadow-md"
          >
            1
          </div>
          <h3 class="mt-6 font-heading text-lg font-bold text-wm-ink">Pick your video</h3>
          <p class="mt-2 text-sm text-wm-muted">
            Choose any video or photo from your device gallery. WhatMedia instantly inspects
            resolution, frame rate, bitrate, and color space.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          class="relative flex flex-col items-center text-center p-6 rounded-wm-card bg-wm-surface border border-wm-border"
        >
          <div
            class="flex h-14 w-14 items-center justify-center rounded-full bg-wm-signal text-white font-heading text-xl font-bold shadow-md"
          >
            2
          </div>
          <h3 class="mt-6 font-heading text-lg font-bold text-wm-ink">WhatMedia optimizes it</h3>
          <p class="mt-2 text-sm text-wm-muted">
            Your phone converts it to the exact spec WhatsApp expects (calibrated H.264, SDR BT.709
            tone mapping, 30 fps) and splits it into smooth segments.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          class="relative flex flex-col items-center text-center p-6 rounded-wm-card bg-wm-surface border border-wm-border"
        >
          <div
            class="flex h-14 w-14 items-center justify-center rounded-full bg-wm-signal text-white font-heading text-xl font-bold shadow-md"
          >
            3
          </div>
          <h3 class="mt-6 font-heading text-lg font-bold text-wm-ink">Share to your status</h3>
          <p class="mt-2 text-sm text-wm-muted">
            Directly share each ready-to-post part into WhatsApp. WhatsApp no longer butchers your
            content!
          </p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a
          href="/en/how-it-works"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-wm-signal hover:text-wm-signal-hover hover:underline underline-offset-4"
        >
          <span>Read detailed technical breakdown (bitrate, HDR, codecs)</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- The Numbers / Benchmarks Section -->
  <!-- Strict rule: NEVER invent quality numbers. Show "Mesures en cours" -->
  <section class="border-y border-wm-border bg-wm-surface py-16 md:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          Measurements & Data
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Objective, lab-verified results
        </p>
        <p class="mt-3 text-base text-wm-muted">
          No miraculous claims. We publish objective VMAF and SSIM benchmark scores measured
          directly on videos served through WhatsApp.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
        <!-- Metric 1: VMAF Gain -->
        <div
          class="flex flex-col items-center justify-center rounded-wm-card border border-wm-border bg-wm-paper p-8 text-center"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-wm-muted"
            >Average VMAF Gain</span
          >
          <span class="mt-3 font-mono text-2xl md:text-3xl font-bold text-wm-warn">
            Mesures en cours
          </span>
          <span class="mt-2 text-xs text-wm-muted">Open testbed protocol</span>
        </div>

        <!-- Metric 2: Tested Clips -->
        <div
          class="flex flex-col items-center justify-center rounded-wm-card border border-wm-border bg-wm-paper p-8 text-center"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-wm-muted"
            >Reference Clips Tested</span
          >
          <span class="mt-3 font-mono text-2xl md:text-3xl font-bold text-wm-warn">
            Mesures en cours
          </span>
          <span class="mt-2 text-xs text-wm-muted">Diverse corpus (HDR, 60fps, action, faces)</span>
        </div>

        <!-- Metric 3: Measurement Date -->
        <div
          class="flex flex-col items-center justify-center rounded-wm-card border border-wm-border bg-wm-paper p-8 text-center"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-wm-muted">Last Updated</span>
          <span class="mt-3 font-mono text-2xl md:text-3xl font-bold text-wm-warn">
            Mesures en cours
          </span>
          <span class="mt-2 text-xs text-wm-muted">Ongoing test consolidation</span>
        </div>
      </div>

      <div class="mt-8 text-center">
        <a
          href="/en/measurements"
          class="inline-flex items-center gap-2 rounded-wm-button border border-wm-border bg-wm-paper px-5 py-2.5 text-sm font-semibold text-wm-ink hover:border-wm-ink transition-colors"
        >
          <span>View test methodology and benchmark graphs</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Privacy Section -->
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-wm-ok/30 bg-wm-ok-light/40 p-8 md:p-12">
        <div class="max-w-3xl">
          <div
            class="inline-flex items-center gap-2 rounded-full bg-wm-ok/10 px-3 py-1 text-xs font-bold text-wm-ok"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"></path>
            </svg>
            PRIVACY BY DESIGN
          </div>
          <h2 class="mt-4 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
            Your videos never leave your phone.
          </h2>
          <p class="mt-4 text-base sm:text-lg text-wm-muted leading-relaxed">
            Unlike traditional online video converters that send your personal footage to unknown
            third-party cloud servers, WhatMedia performs all transcoding locally right inside your
            web browser. Zero bytes of media data are ever sent over the network.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              href="/en/privacy"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-wm-ink underline decoration-wm-ink/30 underline-offset-4 hover:decoration-wm-ink"
            >
              <span>Read privacy policy</span>
            </a>
            <span class="text-wm-muted">·</span>
            <a
              href="https://github.com/nealix/whatmedia"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-wm-ink underline decoration-wm-ink/30 underline-offset-4 hover:decoration-wm-ink"
            >
              <span>Audit source code on GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Install Guide Section (PWA iOS Safari & Android Chrome) -->
  <section class="border-t border-wm-border bg-wm-surface py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto">
        <h2
          class="font-heading text-xs font-mono font-semibold tracking-wider text-wm-signal uppercase"
        >
          Instant Install
        </h2>
        <p class="mt-2 font-heading text-3xl font-bold tracking-tight text-wm-ink sm:text-4xl">
          Add WhatMedia to your home screen
        </p>
        <p class="mt-3 text-base text-wm-muted">
          A genuine Progressive Web App: ultra fast, works offline, and requires no app store
          downloads.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
        <!-- iOS Safari Guide -->
        <div class="rounded-wm-card border border-wm-border bg-wm-paper p-7">
          <div class="flex items-center gap-3">
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl bg-wm-focus-light text-wm-focus font-bold"
            >
              🍎
            </div>
            <div>
              <h3 class="font-heading text-lg font-bold text-wm-ink">iPhone (Safari)</h3>
              <p class="text-xs text-wm-muted">In 2 simple steps</p>
            </div>
          </div>
          <ol class="mt-6 space-y-4 text-sm text-wm-ink">
            <li class="flex items-start gap-3">
              <span
                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-wm-surface border border-wm-border text-xs font-mono font-bold text-wm-signal"
                >1</span
              >
              <span
                >Open this page in <strong>Safari</strong> and tap the <strong>Share</strong> button (the
                box with an upward arrow).</span
              >
            </li>
            <li class="flex items-start gap-3">
              <span
                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-wm-surface border border-wm-border text-xs font-mono font-bold text-wm-signal"
                >2</span
              >
              <span
                >Scroll down and tap <strong>"Add to Home Screen"</strong>. The WhatMedia icon will
