---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Legal Notice — WhatMedia"
  description="Legal notice, publisher information, MIT license, and non-affiliation disclaimer for WhatMedia."
  lang="en"
  currentPath="/en/legal"
>
  <div class="py-12 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 text-xs font-mono text-wm-muted">
        <a href="/en/" class="hover:text-wm-ink">Home</a>
        <span>/</span>
        <span class="text-wm-signal font-semibold">Legal Notice</span>
      </div>

      <h1 class="mt-4 font-heading text-3xl font-extrabold tracking-tight text-wm-ink sm:text-4xl">
        Legal Notice
      </h1>
      <p class="mt-2 font-mono text-xs text-wm-muted">
        Mandatory statutory transparency and publisher disclosures.
      </p>

      <div class="mt-10 space-y-8 text-sm leading-relaxed text-wm-ink">
        <!-- Section 1: Publisher -->
        <section class="space-y-2">
          <h2 class="font-heading text-xl font-bold text-wm-ink">1. Site Publisher</h2>
          <p class="text-wm-muted">
            The website and application <strong>WhatMedia</strong> (<a
              href="https://whatmedia.nealix.org"
              class="text-wm-focus underline">whatmedia.nealix.org</a
            >) are published as an open source initiative by <strong>Nealix</strong>, founded and
            maintained by <strong>Roger Gnanih</strong>.
          </p>
          <p class="text-wm-muted">
            Contact email: <code>contact@nealix.org</code>
          </p>
          <p class="text-wm-muted">
            Source repository: <a
              href="https://github.com/nealix/whatmedia"
              target="_blank"
              rel="noopener noreferrer"
              class="text-wm-focus underline">github.com/nealix/whatmedia</a
            >
          </p>
        </section>

        <!-- Section 2: Hosting -->
        <section class="space-y-2">
          <h2 class="font-heading text-xl font-bold text-wm-ink">2. Infrastructure Hosting</h2>
          <p class="text-wm-muted">
            Static site pages and progressive web application assets are distributed and hosted
            across edge cloud networks (Cloudflare, Inc. / Vercel, Inc.).
          </p>
        </section>

        <!-- Section 3: Open Source License -->
        <section class="space-y-2">
          <h2 class="font-heading text-xl font-bold text-wm-ink">3. Software License (MIT)</h2>
          <p class="text-wm-muted">
            The entirety of WhatMedia source code (web application, static site, <code
              >@whatmedia/core</code
            > TypeScript library, and benchmark suite) is licensed under the permissive <strong
              >MIT License</strong
            >. You are permitted to inspect, modify, fork, and distribute it according to the terms
            of said license.
          </p>
        </section>

        <!-- Section 4: Non-Affiliation Disclaimer -->
        <section class="rounded-xl border border-wm-warn/30 bg-wm-warn-light/30 p-6 space-y-3">
          <h2 class="font-heading text-base font-bold text-wm-warn">
            4. Absolute Non-Affiliation — Third-Party Trademarks
          </h2>
          <p class="text-wm-ink font-medium">Statutory Notice:</p>
          <p class="text-xs text-wm-muted leading-relaxed">
            <strong>WhatMedia</strong> is an independent open-source project. WhatMedia is in no way affiliated,
            associated, authorized, endorsed, sponsored, or officially connected with <strong
              >WhatsApp LLC</strong
            >, <strong>Meta Platforms, Inc.</strong>, or any of their subsidiaries or affiliates.
          </p>
          <p class="text-xs text-wm-muted leading-relaxed">
            The name "WhatsApp" as well as related trade names, trademarks, emblems, and visual
            badges are registered trademarks owned exclusively by Meta Platforms, Inc. The
            referential use of the term "WhatsApp" on this website serves solely to accurately
            describe the technical compatibility and destination of media files processed by the
            user under fair-use descriptive principles.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
