---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../i18n/site';
import { features, featurePath } from '../content/features';
---

<BaseLayout
  lang="fr"
  title="Page introuvable (404)"
  description="Cette page n’existe pas ou a été déplacée. Retrouve l’accueil, les fonctionnalités ou l’application WhatMedia."
  alternates={{ fr: '/404.html', en: '/404.html' }}
  noindex
>
  <section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-wm-signal-text">Erreur 404</p>
    <h1 class="mt-3 text-5xl font-[330] sm:text-6xl">Cette page est introuvable</h1>
    <p class="mt-4 text-lg text-wm-muted">Elle n’existe pas ou a été déplacée. Voici où aller :</p>
    <p class="mt-1 text-sm text-wm-muted" lang="en">This page could not be found. Here is where you can go:</p>

    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/app/" class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center rounded-full bg-wm-ink px-7 font-semibold text-wm-paper">
        Ouvrir WhatMedia
      </a>
      <a href={routes.home.fr} class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center rounded-full border border-wm-border bg-wm-surface px-6 font-semibold hover:border-wm-ink">
        Accueil
      </a>
      <a href={routes.home.en} lang="en" class="inline-flex min-h-12 w-full sm:w-auto items-center justify-center rounded-full border border-wm-border bg-wm-surface px-6 font-semibold hover:border-wm-ink">
        English home
      </a>
    </div>

    <nav aria-label="Pages utiles" class="mt-10">
      <ul class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
        {features.map((f) => <li><a href={featurePath(f, 'fr')} class="inline-flex min-h-11 items-center text-wm-signal-text underline underline-offset-4">{f.fr.title}</a></li>)}
        <li><a href={routes.faq.fr} class="inline-flex min-h-11 items-center text-wm-signal-text underline underline-offset-4">FAQ</a></li>
        <li><a href={routes.contact.fr} class="inline-flex min-h-11 items-center text-wm-signal-text underline underline-offset-4">Contact</a></li>
      </ul>
    </nav>
  </section>
</BaseLayout>
