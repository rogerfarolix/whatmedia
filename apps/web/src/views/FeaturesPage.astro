---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { routes, ui, absolute, type Lang } from '../i18n/site';
import { features, featurePath } from '../content/features';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = {
  fr: {
    title: 'Fonctionnalités',
    description:
      'Vidéos pour le statut, photos, vidéos pour les discussions et serveur de secours : tout ce que WhatMedia fait pour préparer tes fichiers WhatsApp.',
    lead: 'WhatMedia prépare quatre types de fichiers. Chaque outil applique les mêmes principes : rester sous 16 Mo, ne jamais agrandir l’image, et ne rien envoyer sans ton accord.',
    see: 'Voir le détail',
    common: 'Pour tous les fichiers',
    commonList: [
      'Sélection multiple : jusqu’à 20 photos et vidéos traitées automatiquement, puis « Tout partager » ou « Tout enregistrer ».',
      'Aperçu, bouton Partager et bouton Enregistrer pour chaque résultat.',
      'Interface en français et en anglais, utilisable au clavier et avec un lecteur d’écran.',
      'Installable sur l’écran d’accueil, fonctionne hors ligne.',
    ],
  },
  en: {
    title: 'Features',
    description:
      'Videos for status, photos, videos for chats and fallback server: everything WhatMedia does to prepare your WhatsApp files.',
    lead: 'WhatMedia prepares four kinds of files. Each tool follows the same rules: stay under 16 MB, never upscale, and never send anything without your consent.',
    see: 'See details',
    common: 'For every file',
    commonList: [
      'Multiple selection: up to 20 photos and videos processed automatically, then “Share all” or “Save all”.',
      'Preview, Share button and Save button for every result.',
      'Interface in French and English, usable with a keyboard and a screen reader.',
      'Installable on the home screen, works offline.',
    ],
  },
}[lang];

const list = {
  '@type': 'ItemList',
  itemListElement: features.map((f, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: f[lang].title,
    url: absolute(featurePath(f, lang)),
  })),
};
---

<BaseLayout
  lang={lang}
  title={c.title}
  description={c.description}
  alternates={routes.features}
  breadcrumbs={[{ name: ui[lang].nav.features, path: routes.features[lang] }]}
  jsonLd={[list]}
>
  <PageHero title={c.title} lead={c.lead} />
  <section class="pb-14">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <ul class="grid grid-cols-1 gap-5">
        {
          features.map((f) => (
            <li class="rounded-3xl border border-wm-border bg-wm-surface p-6 sm:flex sm:gap-5">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-wm-signal-light text-wm-signal-text">
                <Icon name={f.icon} />
              </span>
              <div class="mt-4 sm:mt-0">
                <h2 class="text-xl font-semibold">
                  <a href={featurePath(f, lang)} class="inline-flex min-h-11 items-center hover:underline underline-offset-4">{f[lang].title}</a>
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-wm-muted">{f[lang].summary}</p>
                <p class="mt-2 text-sm leading-relaxed text-wm-ink">{f[lang].forWho}</p>
                <a href={featurePath(f, lang)} class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-wm-signal-text underline-offset-4 hover:underline">
                  {c.see}
                  <span class="sr-only">: {f[lang].title}</span>
                  <Icon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 rounded-3xl border border-wm-border bg-wm-paper p-6">
        <h2 class="text-lg font-semibold">{c.common}</h2>
        <ul class="mt-3 space-y-2 text-sm text-wm-ink">
          {c.commonList.map((x) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-wm-ok" />{x}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <CtaBand lang={lang} />
</BaseLayout>
