---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Phone from '../components/Phone.astro';
import { routes, REPO_URL, CONTACT_EMAIL, SITE_URL, type Lang } from '../i18n/site';
import { features, featurePath } from '../content/features';
import { faq } from '../content/faq';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const shot = (name: string) => `/shots/${lang}-${name}.webp`;

const c = {
  fr: {
    title: 'WhatMedia : prépare tes vidéos et photos pour les statuts WhatsApp',
    description:
      'Outil gratuit qui découpe, redimensionne et convertit tes vidéos et photos pour les statuts WhatsApp, directement sur ton téléphone. Sans compte, open source.',
    badge: 'Open source · Licence MIT · v1.1',
    h1a: 'Tes statuts WhatsApp,',
    h1em: 'préparés',
    h1b: 'pour rester nets.',
    lead: 'WhatMedia découpe, redimensionne et convertit tes vidéos et tes photos au bon format pour WhatsApp. Tout se passe sur ton téléphone.',
    cta: 'Ouvrir WhatMedia',
    github: 'Voir le code',
    facts: ['Gratuit, sans compte', 'Rien n’est envoyé', 'iPhone et Android'],
    shots: [
      { name: 'analysis', alt: 'Écran d’analyse : vidéo de 2 min 30, découpée en 3 parties de 60 secondes en 1080 × 1920.', caption: 'Analyse' },
      { name: 'processing', alt: 'Écran de traitement : optimisation en cours sur le téléphone, avec le temps restant.', caption: 'Optimisation' },
      { name: 'results', alt: 'Écran de résultats : trois parties prêtes, chacune sous 16 Mo, avec les boutons Partager et Enregistrer.', caption: 'Partage' },
    ],
    worksWith: 'Fonctionne avec',
    formats: ['iPhone', 'Android', 'MP4', 'MOV', 'HEVC', 'HEIC', 'JPEG', 'PNG', 'WebP'],
    servicesKicker: 'Fonctionnalités',
    servicesTitle: 'Quatre outils. Un seul objectif : partir du meilleur fichier.',
    more: 'En savoir plus',
    batchKicker: 'Nouveau',
    batchTitle: 'Toute ta sélection, préparée d’un coup.',
    batchText:
      'Choisis jusqu’à 20 photos et vidéos dans ta galerie. Tu règles le format une seule fois, WhatMedia les traite l’une après l’autre, puis tu partages tout en une fois ou fichier par fichier.',
    batchPoints: ['Réglages communs, les photos passent seules au bon format', 'Un fichier qui échoue ne bloque pas les autres', 'Bouton « Tout partager » et « Tout enregistrer »'],
    batchAlt: 'Écran de sélection multiple : une vidéo et une photo prêtes à être optimisées ensemble.',
    exampleKicker: 'Exemple concret',
    exampleTitle: 'Une vidéo d’iPhone de 2 min 30, filmée en HDR.',
    exampleHead: ['Durée des parties', 'Parties', 'Résolution', 'Débit vidéo'],
    exampleRows: [
      ['30 s', '5', '1080 × 1920', '3,9 Mbit/s'],
      ['60 s', '3', '1080 × 1920', '1,8 Mbit/s'],
      ['90 s', '2', '720 × 1280', '1,1 Mbit/s'],
    ],
    exampleAlways: 'Dans tous les cas : couleurs HDR converties, 30 images par seconde au maximum, chaque fichier sous 16 Mo.',
    exampleNote: 'Valeurs calculées par WhatMedia pour respecter la limite de 16 Mo. Ce ne sont pas des mesures de qualité après passage par WhatsApp.',
    privacyKicker: 'Vie privée',
    privacyTitle: 'Tes fichiers restent à toi.',
    privacyLead: 'Le traitement se fait dans ton navigateur. Pas de compte, pas de cookie, pas de traceur.',
    privacy: [
      ['shield', 'Sur ton téléphone', 'Tes photos et vidéos ne quittent pas ton appareil pendant le traitement.'],
      ['server', 'Serveur seulement si tu le demandes', 'Si ton appareil n’y arrive pas, un serveur de secours est proposé. Rien ne part sans ton accord, et le fichier est supprimé sous 15 minutes.'],
      ['info', 'Aucune promesse impossible', 'WhatsApp recompresse toujours ce qui est publié. WhatMedia prépare le meilleur fichier de départ, rien de plus.'],
      ['github', 'Code ouvert', 'Tout le code est public sous licence MIT : chacun peut vérifier ce que fait l’application.'],
    ],
    privacyLink: 'Lire la politique de confidentialité',
    faqKicker: 'Questions fréquentes',
    faqTitle: 'Avant que tu demandes.',
    faqLink: 'Toutes les questions',
    faqMore: 'Une autre question ?',
    faqWrite: 'Écris-nous',
    finalTitle: 'Ton prochain statut mérite mieux.',
    finalText: 'Gratuit, sans inscription, dans Safari et Chrome. Ajoute-le à ton écran d’accueil en deux gestes.',
    finalAlt: 'Écran d’accueil de WhatMedia sur un téléphone.',
  },
  en: {
    title: 'WhatMedia: prepare your videos and photos for WhatsApp status',
    description:
      'Free tool that splits, resizes and converts your videos and photos for WhatsApp status, right on your phone. No account, open source.',
    badge: 'Open source · MIT License · v1.1',
    h1a: 'Your WhatsApp statuses,',
    h1em: 'prepared',
    h1b: 'to stay sharp.',
    lead: 'WhatMedia splits, resizes and converts your videos and photos to the right format for WhatsApp. Everything happens on your phone.',
    cta: 'Open WhatMedia',
    github: 'See the code',
    facts: ['Free, no account', 'Nothing is uploaded', 'iPhone and Android'],
    shots: [
      { name: 'analysis', alt: 'Analysis screen: a 2 min 30 video, split into three 60-second parts at 1080 × 1920.', caption: 'Analysis' },
      { name: 'processing', alt: 'Processing screen: optimization running on the phone, with the time left.', caption: 'Optimization' },
      { name: 'results', alt: 'Results screen: three parts ready, each under 16 MB, with Share and Save buttons.', caption: 'Sharing' },
    ],
    worksWith: 'Works with',
    formats: ['iPhone', 'Android', 'MP4', 'MOV', 'HEVC', 'HEIC', 'JPEG', 'PNG', 'WebP'],
    servicesKicker: 'Features',
    servicesTitle: 'Four tools. One goal: start from the best possible file.',
    more: 'Learn more',
    batchKicker: 'New',
    batchTitle: 'Your whole selection, prepared at once.',
    batchText:
      'Pick up to 20 photos and videos from your gallery. You set the format once, WhatMedia processes them one after another, then you share everything at once or file by file.',
    batchPoints: ['Shared settings, photos switch to the right format on their own', 'A file that fails does not block the others', '“Share all” and “Save all” buttons'],
    batchAlt: 'Multiple selection screen: a video and a photo ready to be optimized together.',
    exampleKicker: 'A concrete example',
    exampleTitle: 'A 2 min 30 iPhone video, shot in HDR.',
    exampleHead: ['Part length', 'Parts', 'Resolution', 'Video bitrate'],
    exampleRows: [
      ['30 s', '5', '1080 × 1920', '3.9 Mbit/s'],
      ['60 s', '3', '1080 × 1920', '1.8 Mbit/s'],
      ['90 s', '2', '720 × 1280', '1.1 Mbit/s'],
    ],
    exampleAlways: 'In every case: HDR colours converted, 30 frames per second at most, every file under 16 MB.',
    exampleNote: 'Values computed by WhatMedia to respect the 16 MB limit. They are not quality measurements after going through WhatsApp.',
    privacyKicker: 'Privacy',
    privacyTitle: 'Your files stay yours.',
    privacyLead: 'Processing happens in your browser. No account, no cookie, no tracker.',
    privacy: [
      ['shield', 'On your phone', 'Your photos and videos do not leave your device during processing.'],
      ['server', 'Server only if you ask', 'If your device cannot cope, a fallback server is offered. Nothing leaves without your consent, and the file is deleted within 15 minutes.'],
      ['info', 'No impossible promise', 'WhatsApp always recompresses what is posted. WhatMedia prepares the best starting file, nothing more.'],
      ['github', 'Open code', 'All the code is public under the MIT license: anyone can check what the app does.'],
    ],
    privacyLink: 'Read the privacy policy',
    faqKicker: 'Frequently asked questions',
    faqTitle: 'Before you ask.',
    faqLink: 'All questions',
    faqMore: 'Another question?',
    faqWrite: 'Write to us',
    finalTitle: 'Your next status deserves better.',
    finalText: 'Free, no sign-up, in Safari and Chrome. Add it to your home screen in two taps.',
    finalAlt: 'WhatMedia home screen on a phone.',
  },
}[lang];

const app = {
  '@type': 'WebApplication',
  name: 'WhatMedia',
  url: `${SITE_URL}/app/`,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'iOS 16.4+, Android, Windows, macOS, Linux',
  browserRequirements: 'Safari 16.4+, Chrome 110+',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  description: c.description,
  inLanguage: lang,
  screenshot: `${SITE_URL}${shot('results')}`,
  publisher: { '@id': `${SITE_URL}/#organization` },
};
const kicker = 'text-[13px] font-semibold uppercase tracking-[0.14em] text-wm-signal-text';
---

<BaseLayout lang={lang} title={c.title} description={c.description} alternates={routes.home} jsonLd={[app]} fullTitle>
  <!-- Hero -->
  <section class="relative overflow-hidden pt-10 sm:pt-16 md:pt-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 text-center">
      <p class="inline-flex items-center gap-2 rounded-full border border-wm-border bg-wm-surface px-4 py-1.5 text-[13px] font-medium text-wm-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-wm-signal" aria-hidden="true"></span>
        {c.badge}
      </p>
      <h1 class="mx-auto mt-6 max-w-4xl text-[2.6rem] leading-[1.04] text-wm-ink sm:text-6xl md:text-7xl lg:text-[5.25rem]">
        {c.h1a} <span class="text-wm-signal-text">{c.h1em}</span> {c.h1b}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-[17px] leading-relaxed text-wm-muted sm:text-xl">{c.lead}</p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <a
          href="/app/"
          class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-wm-ink px-7 text-base font-semibold text-wm-paper transition-transform hover:-translate-y-0.5"
        >
          {c.cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-13 items-center justify-center gap-2 rounded-full border border-wm-border bg-wm-surface px-6 text-base font-semibold text-wm-ink hover:border-wm-ink"
        >
          <Icon name="github" class="h-5 w-5" />
          {c.github}
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-wm-muted">
        {c.facts.map((f) => <li class="flex items-center gap-1.5"><Icon name="check" class="h-4 w-4 text-wm-ok" />{f}</li>)}
      </ul>
    </div>

    <!-- Stage: real app screens -->
    <div class="mx-auto mt-12 max-w-6xl px-3 sm:px-8">
      <div class="relative overflow-hidden rounded-[2rem] bg-wm-ink px-2 pt-10 pb-0 sm:rounded-[2.5rem] sm:px-10 sm:pt-14">
        <div class="pointer-events-none absolute inset-0 opacity-[0.07] [background-image:radial-gradient(#fff_1px,transparent_1px)] [background-size:22px_22px]" aria-hidden="true"></div>
        <div class="rail relative -mb-24 flex gap-5 overflow-x-auto px-[12%] pb-4 sm:mb-[-7rem] sm:justify-center sm:overflow-visible sm:px-0 md:gap-8">
          {
            c.shots.map((s, i) => (
              <div class={`flex w-[76%] shrink-0 flex-col items-center sm:w-[30%] ${i === 1 ? 'sm:-translate-y-6' : 'sm:translate-y-4'}`}>
                <span class="mb-3 rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80">{`${i + 1}. ${s.caption}`}</span>
                <Phone src={shot(s.name)} alt={s.alt} eager={i === 0} class="w-full max-w-[290px]" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Works with -->
  <section class="pt-32 pb-6 sm:pt-40" aria-label={c.worksWith}>
    <div class="mx-auto max-w-5xl px-5 text-center">
      <p class="text-sm text-wm-muted">{c.worksWith}</p>
      <ul class="mt-4 flex flex-wrap justify-center gap-2">
        {c.formats.map((f) => <li class="rounded-full border border-wm-border bg-wm-surface px-3.5 py-1.5 text-sm font-medium text-wm-ink">{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- Services -->
  <section class="py-20 sm:py-28" aria-labelledby="services-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="reveal max-w-3xl">
        <p class={kicker}>{c.servicesKicker}</p>
        <h2 id="services-title" class="mt-3 text-4xl leading-[1.08] sm:text-5xl">{c.servicesTitle}</h2>
      </div>
      <ul class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {
          features.map((f, i) => (
            <li class="reveal group relative flex flex-col rounded-[1.75rem] border border-wm-border bg-wm-surface p-7 transition-shadow hover:shadow-[0_20px_50px_-30px_rgba(11,15,26,0.45)] sm:p-8">
              <div class="flex items-center justify-between">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-wm-signal-light text-wm-signal-text">
                  <Icon name={f.icon} />
                </span>
                <span class="text-4xl font-semibold tracking-tight text-wm-border" aria-hidden="true">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-xl font-semibold">{f[lang].title}</h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-wm-muted">{f[lang].summary}</p>
              <a href={featurePath(f, lang)} class="mt-6 inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-wm-ink after:absolute after:inset-0 after:content-['']">
                {c.more}
                <span class="sr-only">: {f[lang].title}</span>
                <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Multiple selection spotlight -->
  <section class="pb-20 sm:pb-28" aria-labelledby="batch-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="grid grid-cols-1 items-center gap-10 overflow-hidden rounded-[2rem] border border-wm-border bg-wm-signal-light p-7 sm:p-12 lg:grid-cols-2">
        <div class="reveal">
          <p class={kicker}>{c.batchKicker}</p>
          <h2 id="batch-title" class="mt-3 text-4xl leading-[1.08] sm:text-5xl">{c.batchTitle}</h2>
          <p class="mt-5 text-[17px] leading-relaxed text-wm-ink/80">{c.batchText}</p>
          <ul class="mt-6 space-y-3">
            {c.batchPoints.map((p) => <li class="flex gap-3 text-[15px]"><Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-wm-signal-text" /><span>{p}</span></li>)}
          </ul>
          <a href="/app/" class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-full bg-wm-ink px-6 text-[15px] font-semibold text-wm-paper">
            {c.cta}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
        <div class="reveal flex justify-center lg:-mb-24 lg:translate-y-6">
          <Phone src={shot('batch')} alt={c.batchAlt} class="w-[72%] max-w-[300px]" />
        </div>
      </div>
    </div>
  </section>

  <!-- Example -->
  <section class="pb-20 sm:pb-28" aria-labelledby="example-title">
    <div class="mx-auto max-w-4xl px-5 sm:px-8">
      <div class="reveal">
        <p class={kicker}>{c.exampleKicker}</p>
        <h2 id="example-title" class="mt-3 text-4xl leading-[1.08] sm:text-5xl">{c.exampleTitle}</h2>
      </div>
      <div class="reveal mt-8 overflow-hidden rounded-[1.5rem] border border-wm-border bg-wm-surface">
        <table class="w-full text-left text-[15px]">
          <thead class="border-b border-wm-border text-xs uppercase tracking-wider text-wm-muted">
            <tr>{c.exampleHead.map((h, i) => <th scope="col" class={`px-4 py-3.5 font-semibold sm:px-6 ${i === 2 ? 'hidden sm:table-cell' : ''}`}>{h}</th>)}</tr>
          </thead>
          <tbody>
            {
              c.exampleRows.map((r) => (
                <tr class="border-b border-wm-border last:border-0">
                  <th scope="row" class="px-4 py-4 font-semibold sm:px-6">{r[0]}</th>
                  <td class="px-4 py-4 tabular-nums sm:px-6">{r[1]}</td>
                  <td class="hidden px-4 py-4 tabular-nums sm:table-cell sm:px-6">{r[2]}</td>
                  <td class="px-4 py-4 tabular-nums sm:px-6">{r[3]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-[15px]">{c.exampleAlways}</p>
      <p class="mt-2 flex items-start gap-2 text-sm text-wm-muted"><Icon name="info" class="mt-0.5 h-4 w-4 shrink-0" />{c.exampleNote}</p>
    </div>
  </section>

  <!-- Privacy (dark) -->
  <section class="bg-[#0B0F1A] py-20 text-[#F0F0EC] sm:py-28" aria-labelledby="privacy-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <div class="reveal max-w-3xl">
        <p class="text-[13px] font-semibold uppercase tracking-[0.14em] text-[#FF7A45]">{c.privacyKicker}</p>
        <h2 id="privacy-title" class="mt-3 text-4xl leading-[1.08] text-white sm:text-6xl">{c.privacyTitle}</h2>
        <p class="mt-5 text-lg text-white/70">{c.privacyLead}</p>
      </div>
      <ul class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-[1.75rem] bg-white/10 sm:grid-cols-2">
        {
          c.privacy.map(([icon, title, text]) => (
            <li class="reveal bg-[#0B0F1A] p-7 sm:p-9">
              <Icon name={icon as 'shield'} class="h-6 w-6 text-[#FF7A45]" />
              <h3 class="mt-5 text-lg font-semibold text-white">{title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-white/70">{text}</p>
            </li>
          ))
        }
      </ul>
      <a href={routes.privacy[lang]} class="mt-8 inline-flex min-h-11 items-center gap-1.5 text-[15px] font-semibold text-white underline decoration-white/30 underline-offset-4 hover:decoration-white">
        {c.privacyLink}
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 sm:py-28" aria-labelledby="faq-title">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <div class="reveal text-center">
        <p class={kicker}>{c.faqKicker}</p>
        <h2 id="faq-title" class="mt-3 text-4xl sm:text-5xl">{c.faqTitle}</h2>
      </div>
      <div class="mt-10 divide-y divide-wm-border border-y border-wm-border">
        {
          faq[lang].slice(0, 5).map((item) => (
            <details class="group py-2 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 text-[17px] font-semibold">
                {item.q}
                <span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-wm-border text-lg text-wm-muted group-open:rotate-45 motion-safe:transition-transform">+</span>
              </summary>
              <p class="pb-4 pr-10 text-[15px] leading-relaxed text-wm-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
      <p class="mt-8 text-center text-[15px] text-wm-muted">
        <a href={routes.faq[lang]} class="font-semibold text-wm-ink underline underline-offset-4">{c.faqLink}</a>
        <span aria-hidden="true"> · </span>
        {c.faqMore} <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-wm-ink underline underline-offset-4">{c.faqWrite}</a>
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-3 pb-16 sm:px-8 sm:pb-24">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 overflow-hidden rounded-[2rem] bg-[#0B0F1A] p-8 text-white sm:rounded-[2.5rem] sm:p-14 lg:grid-cols-[1.2fr_1fr]">
      <div class="reveal">
        <h2 class="text-4xl leading-[1.05] text-white sm:text-6xl">{c.finalTitle}</h2>
        <p class="mt-5 max-w-md text-lg text-white/70">{c.finalText}</p>
        <a href="/app/" class="mt-8 inline-flex min-h-13 items-center gap-2 rounded-full bg-[#FF5A1F] px-7 text-base font-semibold text-[#0B0F1A] transition-transform hover:-translate-y-0.5">
          {c.cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
      <div class="reveal flex justify-center lg:-mb-36">
        <Phone src={shot('results')} alt={c.shots[2]?.alt ?? ''} class="w-[70%] max-w-[280px]" />
      </div>
    </div>
  </section>
</BaseLayout>
