---
import { measurements } from '@whatmedia/config';

interface Props {
  lang?: 'fr' | 'en';
}

const { lang = 'fr' } = Astro.props;
const isFr = lang === 'fr';

const medianDirect = measurements.summary.medianVmafDirect;
const medianWM = measurements.summary.medianVmafWhatMedia;
const medianGain = measurements.summary.medianGainPercent;

const t = {
  rawLabel: isFr ? 'Publication directe' : 'Direct upload',
  rawSub: isFr
    ? `Compressé à la volée · VMAF ${medianDirect} / 100`
    : `Compressed on the fly · VMAF ${medianDirect} / 100`,
  wmLabel: isFr ? 'Avec WhatMedia' : 'With WhatMedia',
  wmSub: isFr
    ? `H.264 calibré + BT.709 · VMAF ${medianWM} / 100`
    : `Calibrated H.264 + clean BT.709 · VMAF ${medianWM} / 100`,
  vmafBadge: isFr
    ? `VMAF certifié : ${medianWM} / 100 (+${medianGain}%)`
    : `Certified VMAF: ${medianWM} / 100 (+${medianGain}%)`,
  sliderAria: isFr
    ? 'Curseur de comparaison avant/après qualité vidéo WhatsApp'
    : 'Before/after WhatsApp video quality comparison slider',
  hint: isFr
    ? 'Faites glisser le curseur pour comparer · Données certifiées par banc Netflix libvmaf'
    : 'Drag the slider to compare quality · Certified by Netflix libvmaf benchmark',
  linkText: isFr ? 'Voir le protocole de test' : 'View test protocol',
  linkHref: isFr ? '/mesures' : '/en/measurements',
};
---

<div
  class="relative mx-auto w-full max-w-4xl overflow-hidden rounded-wm-card border border-wm-border bg-wm-surface shadow-xl"
>
  <!-- Top Bar with Status and VMAF Badge -->
  <div
    class="flex flex-wrap items-center justify-between border-b border-wm-border bg-wm-paper/60 px-4 py-3 sm:px-6"
  >
    <div class="flex items-center gap-2">
      <span class="flex h-2.5 w-2.5 relative">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-wm-signal opacity-75"
        ></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-wm-signal"></span>
      </span>
      <span class="text-xs font-mono font-medium text-wm-muted">
        {isFr ? 'Comparatif laboratoire certifié' : 'Certified laboratory benchmark'}
      </span>
    </div>

    <!-- Verified lab measurement badge -->
    <a
      href={t.linkHref}
      class="inline-flex items-center gap-1.5 rounded-full border border-wm-signal/30 bg-wm-signal/10 px-3 py-1 text-xs font-medium text-wm-signal hover:bg-wm-signal/20 transition-colors"
      title={t.linkText}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-3.5 w-3.5"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd"></path>
      </svg>
      <span><strong class="font-semibold">{t.vmafBadge}</strong></span>
    </a>
  </div>

  <!-- Interactive Comparison Frame -->
  <div
    id="comparator-container"
    class="relative h-[340px] sm:h-[420px] md:h-[480px] w-full select-none overflow-hidden bg-[#0A0D14]"
    tabindex="0"
    role="region"
    aria-label={t.sliderAria}
  >
    <!-- RIGHT SIDE / BACKGROUND: "Avec WhatMedia" (Sharp, High fidelity) -->
    <div class="absolute inset-0 flex items-center justify-center p-6 text-white">
      <!-- Simulated High-Res Crisp Video Scene -->
      <div
        class="relative h-full w-full max-w-sm rounded-xl overflow-hidden border border-white/20 bg-gradient-to-br from-indigo-950 via-slate-900 to-orange-950/70 p-6 flex flex-col justify-between shadow-2xl"
      >
        <div class="flex justify-between items-start">
          <span
            class="inline-flex items-center gap-1.5 rounded-md bg-wm-signal px-2.5 py-1 text-xs font-bold tracking-wide text-white uppercase"
          >
            ✓ 1080p · 30fps · SDR BT.709
          </span>
          <div
            class="h-8 w-8 rounded-full border border-white/40 flex items-center justify-center text-xs font-mono"
          >
            HD
          </div>
        </div>

        <!-- Center Crisp Reticle & Detail Elements -->
        <div class="my-auto flex flex-col items-center justify-center text-center space-y-3">
          <div
            class="relative flex h-24 w-24 items-center justify-center rounded-2xl border-2 border-dashed border-wm-signal bg-wm-signal/10 backdrop-blur-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 44 44"
              class="h-12 w-12 text-wm-signal"
              fill="none"
            >
              <path d="M13 19V13H19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              ></path>
              <path d="M31 19V13H25" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              ></path>
              <path d="M13 25V31H19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              ></path>
              <path d="M31 25V31H25" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              ></path>
              <circle cx="22" cy="22" r="3" fill="currentColor"></circle>
            </svg>
            <div
              class="absolute -bottom-2 rounded bg-wm-ok px-1.5 py-0.5 text-[10px] font-mono font-bold text-white uppercase tracking-wider"
            >
              Netteté 100%
            </div>
          </div>
          <div>
            <p class="font-heading text-lg font-bold text-white tracking-tight">
              Détails nets & Contrastes riches
            </p>
            <p class="text-xs text-slate-300">Zéro macroblocs · Aucune coupure inattendue</p>
          </div>
        </div>

        <div class="flex items-center justify-between text-[11px] font-mono text-slate-400">
          <span>Débit constant pré-mâché</span>
          <span>Segment 1/3 (45s)</span>
        </div>
      </div>

      <!-- Right Label Overlay -->
      <div
        class="absolute bottom-4 right-4 z-10 rounded-lg bg-black/75 px-3 py-1.5 backdrop-blur-md border border-white/10 text-right"
      >
        <p class="text-xs font-bold text-wm-signal">{t.wmLabel}</p>
        <p class="text-[10px] text-white/70">{t.wmSub}</p>
      </div>
    </div>

    <!-- LEFT SIDE / FOREGROUND: "Publication directe" (Pixelated, Compressed, Blurry, Washed out) -->
    <div
      id="comparator-clip"
      class="absolute inset-y-0 left-0 overflow-hidden bg-[#0A0D14]"
      style="width: 50%;"
    >
      <div
        class="absolute inset-y-0 left-0 w-[100cqw] min-w-[700px] h-full flex items-center justify-center p-6 text-white"
        style="width: var(--container-width, 896px);"
      >
        <!-- Simulated Low-Bitrate Crushed Video Scene -->
        <div
          class="relative h-full w-full max-w-sm rounded-xl overflow-hidden border border-white/5 bg-gradient-to-br from-slate-900 via-gray-900 to-stone-900 p-6 flex flex-col justify-between filter blur-[1.2px] contrast-75 brightness-90"
        >
          <div class="flex justify-between items-start opacity-70">
            <span
              class="inline-flex items-center gap-1.5 rounded-md bg-zinc-700 px-2 py-0.5 text-[11px] text-zinc-300"
            >
              Recompressé (~720p 1.2 Mbps)
            </span>
            <div
              class="h-7 w-7 rounded-full border border-zinc-600 flex items-center justify-center text-[10px] text-zinc-400"
            >
              SD
            </div>
          </div>

          <!-- Washed Out Detail -->
          <div
            class="my-auto flex flex-col items-center justify-center text-center space-y-3 opacity-60"
          >
            <div
              class="relative flex h-24 w-24 items-center justify-center rounded-2xl border border-zinc-700 bg-zinc-800/40"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 44 44"
                class="h-10 w-10 text-zinc-500"
                fill="none"
              >
                <circle
                  cx="22"
                  cy="22"
                  r="10"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-dasharray="3 3"></circle>
              </svg>
              <div
                class="absolute -bottom-2 rounded bg-zinc-700 px-1.5 py-0.5 text-[9px] font-mono text-zinc-300"
              >
                Artefacts
              </div>
            </div>
            <div>
              <p class="font-heading text-base font-semibold text-zinc-300">
                Couleurs délavées (HDR non converti)
              </p>
              <p class="text-[11px] text-zinc-400">Contours flous · Pâtés de compression</p>
            </div>
          </div>

          <div
            class="flex items-center justify-between text-[10px] font-mono text-zinc-500 opacity-60"
          >
            <span>Débit bridé</span>
            <span>Vidéo tronquée à 30s</span>
          </div>
        </div>
      </div>

      <!-- Left Label Overlay -->
      <div
        class="absolute bottom-4 left-4 z-10 rounded-lg bg-black/75 px-3 py-1.5 backdrop-blur-md border border-white/10 text-left"
      >
        <p class="text-xs font-bold text-zinc-300">{t.rawLabel}</p>
        <p class="text-[10px] text-zinc-400">{t.rawSub}</p>
      </div>
    </div>

    <!-- Divider Handle line -->
    <div
      id="comparator-handle"
      class="pointer-events-none absolute inset-y-0 z-20 w-0.5 bg-white shadow-[0_0_12px_rgba(255,90,31,0.8)]"
      style="left: 50%;"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-wm-signal text-white shadow-lg"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            d="M8 9l-4 3 4 3m8-6l4 3-4 3"></path>
        </svg>
      </div>
    </div>

    <!-- Accessible Range Input Layer -->
    <input
      type="range"
      id="comparator-range"
      min="0"
      max="100"
      value="50"
      aria-label={t.sliderAria}
      class="absolute inset-0 z-30 h-full w-full cursor-ew-resize opacity-0"
    />
  </div>

  <!-- Bottom Helper Caption -->
  <div
    class="border-t border-wm-border bg-wm-surface px-4 py-2.5 text-center text-xs text-wm-muted"
  >
    <span>💡 {t.hint}</span>
  </div>
</div>

<script>
  function setupComparator() {
    const container = document.getElementById('comparator-container');
    const range = document.getElementById('comparator-range') as HTMLInputElement | null;
    const clip = document.getElementById('comparator-clip');
    const handle = document.getElementById('comparator-handle');

    if (!container || !range || !clip || !handle) return;

    const updatePosition = (val: number) => {
      clip.style.width = `${val}%`;
      handle.style.left = `${val}%`;
    };

    const updateContainerWidth = () => {
      const width = container.offsetWidth;
      container.style.setProperty('--container-width', `${width}px`);
    };

    updateContainerWidth();
    window.addEventListener('resize', updateContainerWidth);

    range.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      updatePosition(Number(target.value));
    });
  }

  // Setup on page load
  setupComparator();
  document.addEventListener('astro:page-load', setupComparator);
</script>
