---
import Logo from './Logo.astro';
import { routes, ui, type Alternates, type Lang } from '../i18n/site';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'fr' ? 'en' : 'fr';

const links = [
  { href: routes.features[lang], label: t.nav.features },
  { href: routes.howItWorks[lang], label: t.nav.howItWorks },
  { href: routes.faq[lang], label: t.nav.faq },
  { href: routes.about[lang], label: t.nav.about },
  { href: routes.contact[lang], label: t.nav.contact },
];
const current = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => current === href || (href !== routes.home[lang] && current.startsWith(href));
---

<header class="sticky top-0 z-40 w-full border-b border-wm-border bg-wm-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href={routes.home[lang]} class="flex items-center gap-2.5 rounded-lg py-1" aria-label="WhatMedia">
      <Logo class="h-9 w-9" />
      <span class="font-heading text-xl font-bold tracking-tight text-wm-ink">WhatMedia</span>
    </a>

    <nav class="hidden lg:flex lg:items-center lg:gap-6" aria-label={t.navLabel}>
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="inline-flex min-h-11 items-center text-sm font-medium text-wm-muted hover:text-wm-ink aria-[current=page]:text-wm-ink aria-[current=page]:underline underline-offset-8 decoration-2 decoration-wm-signal"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={alternates[other]}
        hreflang={other}
        lang={other}
        aria-label={t.switchTo}
        class="hidden sm:inline-flex h-11 min-w-11 items-center justify-center rounded-wm-button border border-wm-border px-3 text-xs font-semibold uppercase text-wm-ink hover:border-wm-ink"
      >
        {other}
      </a>
      <a
        href="/app/"
        class="inline-flex h-11 items-center justify-center whitespace-nowrap rounded-wm-button bg-wm-signal px-4 sm:px-5 text-sm font-semibold text-wm-on-signal hover:bg-wm-signal-hover"
      >
        {t.openApp}
      </a>
      <details class="relative lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-wm-border text-wm-ink [&::-webkit-details-marker]:hidden"
          aria-label={t.menuOpen}
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <nav
          aria-label={t.navLabel}
          class="absolute right-0 mt-2 w-64 rounded-wm-card border border-wm-border bg-wm-surface p-3 shadow-lg"
        >
          <ul class="flex flex-col">
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={isCurrent(l.href) ? 'page' : undefined}
                    class="flex min-h-11 items-center rounded-lg px-3 text-base font-medium text-wm-ink hover:bg-wm-paper aria-[current=page]:text-wm-signal-text"
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li class="sm:hidden">
              <a
                href={alternates[other]}
                hreflang={other}
                lang={other}
                class="flex min-h-11 items-center rounded-lg px-3 text-base font-medium text-wm-ink hover:bg-wm-paper"
              >
                {t.switchTo}
              </a>
            </li>
            <li class="mt-2">
              <a
                href="/app/"
                class="flex min-h-11 items-center justify-center rounded-wm-button bg-wm-signal px-4 text-sm font-semibold text-wm-on-signal"
              >
                {t.openApp}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
