---
import Icon from './Icon.astro';
import type { Lang } from '../i18n/site';

interface Props {
  lang: Lang;
  title?: string;
}
const { lang, title } = Astro.props;
const text = {
  fr: { title: 'Essaie avec ton prochain statut', cta: 'Ouvrir WhatMedia', note: 'Gratuit, sans compte, dans Safari ou Chrome.' },
  en: { title: 'Try it with your next status', cta: 'Open WhatMedia', note: 'Free, no account, in Safari or Chrome.' },
}[lang];
---

<section class="px-3 pb-16 sm:px-8">
  <div class="mx-auto max-w-6xl rounded-[2rem] bg-[#0B0F1A] px-6 py-14 text-center text-white sm:rounded-[2.5rem]">
    <h2 class="text-4xl text-white sm:text-5xl">{title ?? text.title}</h2>
    <p class="mt-3 text-white/70">{text.note}</p>
    <a
      href="/app/"
      class="mt-7 inline-flex min-h-13 items-center justify-center gap-2 rounded-full bg-[#FF5A1F] px-7 text-base font-semibold text-[#0B0F1A] hover:-translate-y-0.5 transition-transform"
    >
      {text.cta}
      <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>
</section>
