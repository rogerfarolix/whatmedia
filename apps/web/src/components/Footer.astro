---
import Logo from './Logo.astro';
import { routes, ui, REPO_URL, type Lang } from '../i18n/site';
import { features, featurePath } from '../content/features';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const f = t.footer;

const columns = [
  {
    title: f.product,
    links: [
      ...features.map((x) => ({ href: featurePath(x, lang), label: x[lang].title })),
      { href: routes.howItWorks[lang], label: t.nav.howItWorks },
      { href: routes.measurements[lang], label: f.measurements },
      { href: routes.statistics[lang], label: f.statistics },
    ],
  },
  {
    title: f.project,
    links: [
      { href: routes.about[lang], label: t.nav.about },
      { href: routes.faq[lang], label: t.nav.faq },
      { href: routes.contact[lang], label: t.nav.contact },
      { href: REPO_URL, label: f.source, external: true },
    ],
  },
  {
    title: f.legalCol,
    links: [
      { href: routes.privacy[lang], label: f.privacy },
      { href: routes.terms[lang], label: f.terms },
      { href: routes.legal[lang], label: f.legal },
    ],
  },
];
---

<footer class="border-t border-wm-border bg-wm-surface py-12">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-5">
      <div class="md:col-span-2 space-y-4">
        <a href={routes.home[lang]} class="inline-flex items-center gap-2.5">
          <Logo class="h-8 w-8" />
          <span class="text-lg font-semibold tracking-tight text-wm-ink">WhatMedia</span>
        </a>
        <p class="max-w-sm text-sm text-wm-muted">{f.tagline}</p>
        <a
          href="/app/"
          class="inline-flex h-11 items-center rounded-full bg-wm-ink px-5 text-sm font-semibold text-wm-paper hover:opacity-90"
        >
          {t.openApp}
        </a>
      </div>

      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="font-[Inter] text-sm font-semibold tracking-normal text-wm-ink">{col.title}</h2>
            <ul class="mt-3 space-y-1">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    target={'external' in l && l.external ? '_blank' : undefined}
                    rel={'external' in l && l.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex min-h-9 items-center text-sm text-wm-muted hover:text-wm-ink hover:underline underline-offset-4"
                  >
                    {l.label}
                    {'external' in l && l.external && <span class="sr-only"> {t.newTab}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="mt-10 border-t border-wm-border pt-6 text-xs text-wm-muted space-y-2">
      <p>{f.disclaimer}</p>
      <p>{f.credit}</p>
    </div>
  </div>
</footer>
